PORT=5000
MONGODB_URI=mongodb://localhost:27017/synctube
CLIENT_URL=http://localhost:5173
NODE_ENV=development
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# SMTP Email Invitations (Nodemailer SMTP ONLY)
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587 (or 465)
#   SMTP_SECURE=false (use true if port 465)
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASS=your_16_character_google_app_password (generate in Google Account -> Security -> App Passwords)
#   EMAIL_FROM=your_email@gmail.com
#   EMAIL_FROM_NAME=SyncTube
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=SyncTube

# Cloudinary Audio Storage (Voice Messages)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
